{
  "name": "@tacos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/server.js",
    "worker": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/worker.js",
    "nightly": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/nightly.js",
    "migrate": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/migrate.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@fastify/cors": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.5.0",
    "jose": "^6.2.12",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
