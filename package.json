{
  "name": "tacos",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "pg": "^8.16.3"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @tacos/mobile start",
    "dev:expo": "pnpm --filter @tacos/mobile start",
    "dev:ios": "pnpm --filter @tacos/mobile ios",
    "dev:android": "pnpm --filter @tacos/mobile android",
    "dev:local": "pnpm --parallel --filter @tacos/api --filter @tacos/mobile run dev",
    "dev:api": "pnpm --filter @tacos/api dev",
    "release:ios": "node scripts/release-mobile.mjs ios --submit",
    "release:ios:build": "node scripts/release-mobile.mjs ios",
    "release:android": "node scripts/release-mobile.mjs android",
    "typecheck": "pnpm -r typecheck",
    "build:api": "pnpm --filter @tacos/api build",
    "catalog:import": "node scripts/import-catalog.mjs",
    "catalog:import:osm": "node scripts/import-osm-catalog.mjs",
    "catalog:ensure:osm": "node scripts/ensure-osm-catalog.mjs",
    "catalog:ensure:denue": "node scripts/ensure-denue-catalog.mjs",
    "catalog:discover:ids": "python scripts/discover-taqueria-ids.py --batch-size 60 --strategy admin --grid-step 0.25 --query-delay 2 --request-timeout 180 --endpoint-retries 2",
    "catalog:enrich:ids": "python scripts/enrich-taqueria-ids.py --batch-size 60",
    "catalog:discover:google": "python scripts/discover-google-place-ids.py --region cdmx-edomex",
    "catalog:import:google": "node scripts/import-google-place-candidates.mjs",
    "catalog:import:manual": "python scripts/import_manual_taco_candidates.py",
    "catalog:geocode:manual": "python scripts/geocode_manual_candidates.py",
    "catalog:publish:manual": "python scripts/publish_manual_candidates.py",
    "catalog:build:osm": "node scripts/build-osm-catalog.mjs",
    "catalog:download:denue": "python scripts/download-denue.py",
    "catalog:build:denue": "python scripts/build-denue-catalog.py",
    "catalog:build:all": "python scripts/build-denue-catalog.py --include-osm --include-osm-candidates --output catalog/cdmx-edomex.json",
    "catalog:audit": "python scripts/audit-catalog.py",
    "catalog:refresh": "node scripts/refresh-catalog.mjs",
    "catalog:build:mobile": "node scripts/build-mobile-catalog.mjs",
    "smoke:catalog": "node scripts/smoke-catalog.mjs",
    "smoke:mobile-catalog": "node scripts/smoke-mobile-catalog.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "smoke:hours": "node scripts/smoke-hours.mjs",
    "smoke:radar": "node scripts/smoke-radar.mjs",
    "smoke:inputs": "node scripts/smoke-inputs.mjs",
    "smoke:config": "node scripts/smoke-config.mjs",
    "smoke:render-free": "node scripts/smoke-render-free.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:security": "node scripts/smoke-security.mjs"
  }
}
