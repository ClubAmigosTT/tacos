# Mobile (Expo/EAS)
# Web/iOS simulator: http://localhost:4000
# Android emulator: http://10.0.2.2:4000
# Physical device: use the computer's LAN IP, e.g. http://192.168.1.70:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_DEMO_MODE=false
GOOGLE_MAPS_API_KEY=

# Catalog import (never commit catalog/branches.json with unlicensed media)
CATALOG_FILE=catalog/branches.json
CATALOG_FEED_URL=
CATALOG_SOURCE_NAME=
CATALOG_SOURCE_URL=
CATALOG_SOURCE_LICENSE=
CATALOG_ALLOW_PARTIAL=false
CATALOG_REPLACE_DEMO=false
CATALOG_RECONCILE=false
ALLOW_DEMO_CATALOG=false
